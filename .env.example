# =========================
# DATABASE CONFIG
# =========================
DB_URL=jdbc:mysql://localhost:3306/edu360_system?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_db_password

# =========================
# JWT CONFIG
# =========================
JWT_COOKIE_NAME=edu360_token
# IMPORTANT: JWT_SECRET must be a valid Base64 string (at least 32 bytes = 256 bit)
JWT_SECRET=your_base64_encoded_jwt_secret_at_least_32_bytes
JWT_EXPIRATION=86400000

# =========================
# MAIL SERVER CONFIG (Gmail)
# =========================
# To use Gmail:
# 1. Enable 2-Step Verification in Google Account
# 2. Create App Password: https://myaccount.google.com/apppasswords
# 3. Enter email and app password here
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# =========================
# VIETQR CONFIG
# =========================
VIETQR_BANK_CODE=970422
VIETQR_ACCOUNT_NUMBER=your_bank_account_number
VIETQR_ACCOUNT_NAME=YOUR_ACCOUNT_NAME
VIETQR_TEMPLATE_ID=compact2
VIETQR_BASE_URL=https://api.vietqr.io/image

# =========================
# GOOGLE OAUTH2 CONFIG
# =========================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# =========================
# ENROLLMENT CONFIG
# =========================
ENROLL_REQUIRE_PAID=false

# =========================
# CASSO WEBHOOK CONFIG
# =========================
# Get from https://my.casso.vn -> Webhook settings -> Secure Token
CASSO_WEBHOOK_SECRET_TOKEN=your_casso_secure_token

# =========================
# PAYOS CONFIG
# =========================
# Get from https://my.payos.vn -> Payment Channel -> Channel Details
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key

# =========================
# COOKIE SECURE CONFIG
# =========================
# true for HTTPS (production), false for HTTP (localhost)
COOKIE_SECURE=false

# =========================
# CLOUDINARY CONFIG
# =========================
# Register at: https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
